# Copia este archivo como ".env" y rellénalo. NUNCA subas ".env" a GitHub.

# Frase semilla de la cuenta con la que despliegas en Acurast (la pide el CLI)
ACURAST_MNEMONIC=

# Token NUEVO del bot (BotFather -> /revoke para generar uno nuevo)
BOT_TOKEN=

# Dirección https donde alojaste el juego (GitHub Pages, por ejemplo)
GAME_URL=https://TU_USUARIO.github.io/gem-rush/

# Segundos que escucha el bot en cada ejecución (debe ser menor que la duración de la ejecución)
RUN_SECONDS=50
